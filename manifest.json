{
  "manifest_version": 3,
  "name": "桥 · Session Bridge",
  "version": "0.4.2",
  "version_name": "0.4.2",
  "description": "把当前会话安全接到下一个窗口：原生输入迁移（不经剪贴板），支持完整原文与滚动压缩。存档仅保存在本地。",
  "permissions": ["storage", "unlimitedStorage", "webRequest", "sidePanel", "clipboardWrite"],
  "host_permissions": ["https://chat.deepseek.com/*"],
  "optional_host_permissions": ["https://api.deepseek.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["src/recorder-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["src/recorder-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["src/transport.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 桥 · Session Bridge 侧栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  }
}
